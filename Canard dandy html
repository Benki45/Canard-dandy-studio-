function renderQueue() {
    const queueEl = document.getElementById('queue');
    if (!state.queue.length) { queueEl.style.display = 'none'; return; }
    queueEl.style.display = 'block';
    const total = state.queue.length;
    const done = state.completed + state.failed;
    const inProgress = state.queue.filter(q => q.status === 'processing').length;
    const pending = total - done - inProgress;
    const estGen = estimateGenerationTime(state.durationFrames) / 1000;
    const eta = pending > 0 ? (pending * (createIntervalMs / 1000)) + estGen : (inProgress * estGen / Math.max(inProgress, 1));
    let html = '<div class="queue-summary">' +
        '<span class="progress-text">Progression : ' + done + '/' + total + '</span>' +
        '<span class="eta-text">' + (done < total ? '≈ ' + formatEta(eta) + ' restant' : 'Terminé') + '</span>' +
        '</div>';
    const visible = state.queue.slice(0, MAX_VISIBLE_QUEUE);
    const hidden = state.queue.length - visible.length;
    html += visible.map(item => {
        let icon = '○', statusText = 'En file d\'attente', cls = 'pending';
        if (item.status === 'creating') { icon = '◐'; statusText = 'Préparation…'; cls = 'creating'; }
        else if (item.status === 'processing') { icon = '◐'; statusText = item.progress || 'En cours…'; cls = 'processing'; }
        else if (item.status === 'done') { icon = '●'; statusText = 'Terminé'; cls = 'done'; }
        else if (item.status === 'failed') { icon = '✕'; statusText = 'Échec'; cls = 'failed'; }
        return '<div class="queue-item ' + cls + '">' +
            '<div class="q-icon">' + icon + '</div>' +
            '<div class="q-name">Image ' + (item.imageIndex + 1) + '</div>' +
            '<div class="q-status">' + esc(statusText) + '</div>' +
        '</div>';
    }).join('');
    if (hidden > 0) html += '<div class="queue-more">… et ' + hidden + ' autre' + (hidden > 1 ? 's' : '') + '</div>';
    queueEl.innerHTML = html;
}

function addToGallery(videoUrl, label) {
    const galleryEl = document.getElementById('gallery');
    const galleryGrid = document.getElementById('gallery-grid');
    galleryEl.style.display = 'block';
    const el = document.createElement('div');
    el.className = 'gallery-item';
    el.innerHTML = '<video controls preload="metadata" muted playsinline>' +
        '<source src="' + videoUrl + '" type="video/mp4">' +
        '</video>' +
        '<div class="g-caption">' + esc(label) + '</div>';
    galleryGrid.appendChild(el);
}

// ══════════════════════════════════════════════════════════════════
// PIPELINE
// ══════════════════════════════════════════════════════════════════
async function createTaskOnly(item) {
    item.status = 'creating';
    item.progress = 'Préparation…';
    renderQueue();
    const prompt = buildPrompt();
    item.prompt = prompt;
    const videoId = await createVideoTask(item.image.dataUri, prompt);
    item.videoId = videoId;
    item.startTime = Date.now();
    item.status = 'processing';
    item.progress = 'En cours…';
    renderQueue();
    return videoId;
}

async function pollTaskAndDisplay(item) {
    try {
        const videoUrl = await pollVideo(item.videoId, (prog) => {
            item.progress = prog;
            renderQueue();
        });
        const elapsed = Date.now() - item.startTime;
        recordGenerationTime(state.durationFrames, elapsed);
        item.status = 'done';
        item.videoUrl = videoUrl;
        item.progress = 'Terminé';
        state.completed++;
        renderQueue();
        updateGenerateBtn();
        addToGallery(videoUrl, 'Image ' + (item.imageIndex + 1));
    } catch (e) {
        if (e.message === 'Arrêt demandé') {
            item.status = 'failed';
            item.progress = 'Arrêté';
        } else {
            item.status = 'failed';
            item.progress = 'Échec';
            state.failed++;
        }
        renderQueue();
        updateGenerateBtn();
    }
}

// ══════════════════════════════════════════════════════════════════
// WORKFLOW
// ══════════════════════════════════════════════════════════════════
async function startGeneration() {
    if (state.isRunning || !state.images.length) return;
    if (!getApiKey()) {
        showToast('Ajoutez d\'abord votre clé API', 'error');
        document.getElementById('api-key-input').focus();
        setMascotMessage('noKey');
        return;
    }
    state.mainPrompt = document.getElementById('main-prompt').value.trim();
    if (!state.mainPrompt && !state.selectedEffect) {
        if (!confirm('Ni prompt ni effet sélectionné. Continuer avec un style aléatoire ?')) return;
    }
    state.isRunning = true;
    state.stopRequested = false;
    state.completed = 0;
    state.failed = 0;
    state.creationAttemptsSinceLastError = 0;
    createIntervalMs = CREATE_INTERVAL_MIN;
    state.queue = state.images.map((img, i) => ({
        imageIndex: i, image: img, status: 'pending', progress: null,
        videoId: null, videoUrl: null, prompt: null, startTime: null
    }));
    document.getElementById('gallery-grid').innerHTML = '';
    document.getElementById('gallery').style.display = 'none';
    document.getElementById('stop-btn').classList.add('visible');
    document.getElementById('generate-btn').disabled = true;
    await ensureWakeLockActive();
    renderQueue();
    updateGenerateBtn();
    setMascotMessage('generating');
    const totalStart = Date.now();
    const pollingTasks = [];
    try {
        for (let i = 0; i < state.queue.length; i++) {
            if (state.stopRequested) break;
            const item = state.queue[i];
            try {
                await createTaskOnly(item);
                pollingTasks.push(pollTaskAndDisplay(item));
            } catch (e) {
                if (e.message === 'Arrêt demandé') break;
                item.status = 'failed';
                item.progress = 'Échec';
                state.failed++;
                renderQueue();
                updateGenerateBtn();
            }
            if (i < state.queue.length - 1 && !state.stopRequested) {
                const waitSec = Math.ceil(createIntervalMs / 1000);
                for (let r = waitSec; r > 0; r--) {
                    if (state.stopRequested) break;
                    setStatus('Respiration créative… — Image ' + (i + 2) + '/' + state.queue.length + ' dans ' + r + 's');
                    await sleep(1000);
                }
            }
        }
        if (pollingTasks.length > 0) {
            setStatus('Finalisation…');
            await Promise.allSettled(pollingTasks);
        }
    } catch (e) {
        log('Erreur globale : ' + e.message);
    }
    const totalElapsed = (Date.now() - totalStart) / 1000;
    const summary = state.stopRequested
        ? 'Arrêté — ' + state.completed + '/' + state.queue.length + ' vidéos'
        : '✦ ' + state.completed + '/' + state.queue.length + ' vidéos créées en ' + formatEta(totalElapsed) + ' ✦';
    setStatus(summary);
    await sleep(4000);
    setStatus(null);
    state.isRunning = false;
    state.stopRequested = false;
    document.getElementById('stop-btn').classList.remove('visible');
    updateGenerateBtn();
    if (state.stopRequested) setMascotMessage('stopped');
    else if (state.completed > 0) setMascotMessage('done');
    showToast(state.completed + ' vidéo' + (state.completed > 1 ? 's' : '') + ' créée' + (state.completed > 1 ? 's' : ''), 'success');
}

function stopGeneration() {
    if (!state.isRunning) return;
    state.stopRequested = true;
    setStatus('Arrêt en cours…');
}

// ══════════════════════════════════════════════════════════════════
// INIT
// ══════════════════════════════════════════════════════════════════
(function init() {
    const saveBtn = document.getElementById('api-save-btn');
    if (saveBtn) saveBtn.addEventListener('click', saveApiKey);
    const stopBtn = document.getElementById('stop-btn');
    if (stopBtn) stopBtn.addEventListener('click', stopGeneration);
    const apiInput = document.getElementById('api-key-input');
    if (apiInput) {
        apiInput.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') { e.preventDefault(); saveApiKey(); }
        });
    }
    document.querySelectorAll('[data-toggle]').forEach(header => {
        header.addEventListener('click', () => {
            document.getElementById(header.dataset.toggle).classList.toggle('open');
        });
    });
    const uploadZone = document.getElementById('upload-zone');
    const fileInput = document.getElementById('file-input');
    if (uploadZone && fileInput) {
        uploadZone.addEventListener('click', () => fileInput.click());
        fileInput.addEventListener('change', e => {
            handleFiles(e.target.files);
            fileInput.value = '';
        });
    }
    const mainPrompt = document.getElementById('main-prompt');
    if (mainPrompt) mainPrompt.addEventListener('input', e => { state.mainPrompt = e.target.value; });
    const durationSelect = document.getElementById('duration-select');
    if (durationSelect) durationSelect.addEventListener('change', e => { state.durationFrames = parseInt(e.target.value, 10); });
    const framingSelect = document.getElementById('framing-select');
    if (framingSelect) framingSelect.addEventListener('change', e => { state.framing = e.target.value; });
    const intensitySelect = document.getElementById('intensity-select');
    if (intensitySelect) intensitySelect.addEventListener('change', e => { state.intensity = e.target.value; });
    const generateBtn = document.getElementById('generate-btn');
    if (generateBtn) generateBtn.addEventListener('click', startGeneration);
    const wakeBtn = document.getElementById('wake-toggle-btn');
    if (wakeBtn) wakeBtn.addEventListener('click', toggleWakeLock);
    try {
        const saved = localStorage.getItem(WAKE_LOCK_PREF);
        wakeLockEnabled = saved === '1';
    } catch (e) {}
    if (wakeLockEnabled) activateWakeLock().then(() => updateWakeStatus());
    if (!getApiKey()) setMascotMessage('noKey');
    else if (state.images.length === 0) setMascotMessage('noImages');
    updateApiPanel();
    updateTimingDisplay();
    updateWakeStatus();
    renderPromptPresets();
    renderStyles();
    renderImages();
    renderQueue();
    log('Canard Dandy Studio prêt.');
})();
</script>

