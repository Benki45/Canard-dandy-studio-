function getApiKey() {
    try { return (localStorage.getItem(API_KEY_STORAGE) || '').trim(); }
    catch (e) { return ''; }
}

function saveApiKey() {
    const input = document.getElementById('api-key-input');
    if (!input) return;
    const key = input.value.trim();
    if (!key) {
        try { localStorage.removeItem(API_KEY_STORAGE); } catch (e) {}
        updateApiPanel();
        showToast('Clé supprimée', 'warn');
        setMascotMessage('noKey');
        return;
    }
    if (!key.startsWith('sk-')) {
        if (!confirm('La clé ne commence pas par "sk-". La sauvegarder quand même ?')) return;
    }
    try {
        localStorage.setItem(API_KEY_STORAGE, key);
        updateApiPanel();
        showToast('Clé API enregistrée ✓', 'success');
        input.blur();
    } catch (e) {
        showToast('Erreur lors de la sauvegarde', 'error');
    }
}

function updateApiPanel() {
    const panel = document.getElementById('api-panel');
    const input = document.getElementById('api-key-input');
    const statusLine = document.getElementById('api-status-line');
    const statusText = document.getElementById('api-status-text');
    const key = getApiKey();
    if (!panel || !input || !statusLine || !statusText) return;
    if (key) {
        panel.classList.add('ok');
        statusLine.classList.add('ok');
        statusText.textContent = 'Clé API active · ' + key.slice(0, 8) + '…' + key.slice(-4);
        input.value = key;
        input.placeholder = '';
    } else {
        panel.classList.remove('ok');
        statusLine.classList.remove('ok');
        statusText.textContent = 'Aucune clé API enregistrée';
        input.value = '';
        input.placeholder = 'Collez votre clé API ici (sk-...)';
    }
    updateGenerateBtn();
}

function updateGenerateBtn() {
    const btn = document.getElementById('generate-btn');
    if (!btn) return;
    const hasImages = state.images.length > 0;
    const hasKey = !!getApiKey();
    btn.disabled = !hasImages || !hasKey || state.isRunning || state.isLoadingImages;
    if (state.isLoadingImages) {
        btn.textContent = 'Chargement des images… (' + state.images.length + ')';
    } else if (state.isRunning) {
        const total = state.queue.length;
        const done = state.completed + state.failed;
        btn.textContent = 'Création en cours… (' + done + '/' + total + ')';
    } else if (!hasKey) {
        btn.textContent = '🔑 Ajoutez votre clé API';
    } else if (!hasImages) {
        btn.textContent = '📸 Ajoutez des images';
    } else {
        btn.textContent = '🎬 Créer ' + state.images.length + ' vidéo' + (state.images.length > 1 ? 's' : '');
    }
}

