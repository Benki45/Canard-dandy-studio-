function buildPrompt() {
    const allEffects = AMBIANCE_EFFECTS.concat(STYLIZE_EFFECTS);
    const effect = state.selectedEffect ? allEffects.find(s => s.id === state.selectedEffect) : null;
    const isStylize = effect && STYLIZE_EFFECTS.some(s => s.id === state.selectedEffect);
    const hasUserPrompt = state.mainPrompt && state.mainPrompt.trim().length > 0;
    const parts = [];
    if (isStylize) {
        parts.push('Animate this image as the starting frame. Transform the entire image into the following artistic style:');
    } else {
        parts.push('Animate this exact image as the starting frame. ' +
            'The subject must remain IDENTICAL to the input image: same face, same expression, same clothing, same pose, same identity. ' +
            'This is a CONTINUATION of the source image. Preserve the exact composition, framing, and layout. ' +
            'Only subtle motion, breathing, light, and atmosphere are animated.');
    }
    if (effect) {
        parts.push(effect.prompt);
        if (isStylize) parts.push('Maintain the same subject, pose, and composition, but reinterpret everything in this new style.');
    }
    if (hasUserPrompt) {
        if (isStylize) parts.push('Additional artistic direction: ' + state.mainPrompt.trim());
        else parts.push('Artistic direction (highest priority, must not change the subject identity): ' + state.mainPrompt.trim());
    }
    if (state.framing !== 'random' && FRAMING_PRESETS[state.framing]) parts.push(FRAMING_PRESETS[state.framing]);
    if (state.intensity !== 'random' && INTENSITY_PRESETS[state.intensity]) parts.push(INTENSITY_PRESETS[state.intensity]);
    else parts.push('moderate movement, clear but controlled motion');
    parts.push(randomItem(RANDOM_ACTIONS));
    parts.push(randomItem(RANDOM_CAMERA));
    parts.push(randomItem(RANDOM_LIGHTING));
    parts.push('Sound design: minimal foley, soft ambient textures, no music, no instruments, no dialogue');
    parts.push('Portrait orientation 9:16 vertical, 24fps, no text, no subtitles, no watermarks, consistent character design');
    parts.push('Overall aesthetic: elegant, generous, warm, with subtle emerald green, gold, and bordeaux accents');
    return parts.join('. ');
}

