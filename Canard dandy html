<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="theme-color" content="#1e8a4a">
<meta name="description" content="Canard Dandy Studio — Transformez vos images en vidéos IA avec panache">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Canard Dandy">
<meta name="mobile-web-app-capable" content="yes">
<link rel="manifest" id="pwa-manifest">
<link rel="icon" id="pwa-icon">
<link rel="apple-touch-icon" id="pwa-apple-icon">
<title>Canard Dandy Studio</title>
<style>
    * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
    :root {
        --bg: #0f1a12;
        --panel: #16261a;
        --panel-2: #1e3324;
        --border: #2e4a36;
        --ink: #e8f5e9;
        --ink-dim: #8faa96;
        --ink-faint: #5a7a62;
        --emerald: #2ecc71;
        --emerald-dark: #1e8a4a;
        --gold: #f1c40f;
        --gold-dark: #b8940a;
        --bordeaux: #7b2d3b;
        --bordeaux-light: #a63d4f;
        --success: #2ecc71;
        --error: #e74c3c;
        --warn: #f39c12;
        --info: #4a9eff;
        --radius: 16px;
    }
    body {
        font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Arial, sans-serif;
        background: var(--bg);
        color: var(--ink);
        min-height: 100vh;
        padding: 1.5rem 1rem 6rem;
        font-size: 15px;
        line-height: 1.5;
        max-width: 900px;
        margin: 0 auto;
        background-image:
            radial-gradient(ellipse at 20% 0%, rgba(46,204,113,0.08) 0%, transparent 60%),
            radial-gradient(ellipse at 80% 100%, rgba(123,45,59,0.1) 0%, transparent 60%);
        padding-top: max(1.5rem, env(safe-area-inset-top));
        padding-bottom: max(6rem, calc(6rem + env(safe-area-inset-bottom)));
    }

    .install-banner {
        display: none;
        background: linear-gradient(135deg, var(--emerald-dark), var(--gold));
        color: #0f1a12;
        padding: 0.9rem 1rem;
        border-radius: var(--radius);
        margin-bottom: 1rem;
        font-size: 0.85rem;
        font-weight: 600;
        align-items: center;
        gap: 0.7rem;
        cursor: pointer;
        box-shadow: 0 4px 20px rgba(46,204,113,0.3);
        animation: pulse 2s infinite;
    }
    .install-banner.visible { display: flex; }
    .install-banner .install-icon { font-size: 1.6rem; }
    .install-banner .install-text { flex: 1; }
    .install-banner .install-text strong { display: block; font-size: 0.95rem; margin-bottom: 0.1rem; }
    .install-banner .install-text small { font-size: 0.72rem; opacity: 0.8; font-weight: 500; }
    .install-banner button {
        background: rgba(0,0,0,0.2);
        border: none;
        color: #0f1a12;
        padding: 0.5rem 0.9rem;
        border-radius: 8px;
        font-weight: 700;
        font-size: 0.8rem;
        cursor: pointer;
        font-family: inherit;
    }
    @keyframes pulse {
        0%, 100% { box-shadow: 0 4px 20px rgba(46,204,113,0.3); }
        50% { box-shadow: 0 4px 30px rgba(241,196,15,0.5); }
    }

    .mascot-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.2rem;
        padding: 1rem 1.2rem;
        background: linear-gradient(135deg, var(--panel) 0%, var(--panel-2) 100%);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        position: relative;
        overflow: hidden;
    }
    .mascot-header::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 3px;
        background: linear-gradient(90deg, var(--emerald), var(--gold), var(--bordeaux));
    }
    .mascot-avatar {
        width: 72px;
        height: 72px;
        flex-shrink: 0;
        border-radius: 50%;
        background: radial-gradient(circle at 35% 30%, #3dff8a, var(--emerald-dark));
        border: 3px solid var(--gold);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.2rem;
        position: relative;
        box-shadow: 0 0 20px rgba(46,204,113,0.3);
        animation: mascotFloat 3s ease-in-out infinite;
    }
    @keyframes mascotFloat {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-4px); }
    }
    .mascot-avatar::after {
        content: '🦆';
        font-size: 2rem;
        filter: drop-shadow(0 2px 4px rgba(0,0,0,0.4));
    }
    .mascot-speech { flex: 1; min-width: 0; }
    .mascot-name {
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--gold);
        letter-spacing: 0.05em;
        text-transform: uppercase;
        margin-bottom: 0.2rem;
    }
    .mascot-bubble {
        font-size: 0.82rem;
        color: var(--ink);
        line-height: 1.45;
        font-style: italic;
        background: rgba(241,196,15,0.08);
        border-left: 3px solid var(--gold);
        padding: 0.5rem 0.7rem;
        border-radius: 0 8px 8px 0;
        transition: opacity 0.3s;
    }

    h1 {
        font-size: 1.5rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        margin-bottom: 0.2rem;
        background: linear-gradient(90deg, var(--emerald), var(--gold));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        text-align: center;
    }
    .subtitle {
        font-size: 0.78rem;
        color: var(--ink-dim);
        font-style: italic;
        margin-bottom: 1rem;
        text-align: center;
    }

    .toast {
        position: fixed; top: 1.5rem; left: 50%;
        transform: translateX(-50%) translateY(-120px);
        background: var(--panel-2); color: var(--ink);
        padding: 0.85rem 1.4rem; border-radius: 12px;
        font-size: 0.85rem; font-weight: 500;
        box-shadow: 0 8px 30px rgba(0,0,0,0.4);
        border: 1px solid var(--border);
        z-index: 1000; opacity: 0;
        transition: transform 0.4s cubic-bezier(0.34,1.56,0.64,1), opacity 0.3s;
        max-width: 90vw; text-align: center;
        display: flex; align-items: center; gap: 0.5rem;
    }
    .toast.visible { transform: translateX(-50%) translateY(0); opacity: 1; }
    .toast.success { border-color: var(--success); background: #1a3324; }
    .toast.error { border-color: var(--error); background: #331a1a; }
    .toast.warn { border-color: var(--warn); background: #33291a; }

    .info-banner {
        background: linear-gradient(135deg, rgba(46,204,113,0.08), rgba(123,45,59,0.08));
        border-left: 4px solid var(--gold);
        padding: 0.85rem 1rem;
        border-radius: 10px;
        font-size: 0.78rem;
        color: var(--ink);
        margin-bottom: 1rem;
        line-height: 1.5;
    }
    .info-banner strong { color: var(--gold); }

    .section {
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        margin-bottom: 1rem;
        overflow: hidden;
        transition: border-color 0.3s;
    }
    .section:focus-within { border-color: var(--emerald); }
    .section-header {
        padding: 0.95rem 1.1rem;
        cursor: pointer;
        user-select: none;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .section-header:active { background: var(--panel-2); }
    .section-title {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--gold);
        font-weight: 700;
    }
    .section-title .badge {
        display: inline-block; margin-left: 0.4rem; padding: 0.1rem 0.5rem;
        background: var(--emerald-dark); color: #fff; border-radius: 10px;
        font-size: 0.62rem; letter-spacing: 0;
    }
    .section-title .badge.soft { background: var(--bordeaux); }
    .section-header .chevron {
        font-size: 0.7rem; color: var(--ink-faint); transition: transform 0.25s;
    }
    .section.open .section-header .chevron { transform: rotate(180deg); }
    .section-body { max-height: 0; overflow: hidden; transition: max-height 0.35s ease; }
    .section.open .section-body { max-height: 5000px; }
    .section-content { padding: 0 1.1rem 1.1rem; }

    .api-panel {
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 1rem 1.2rem;
        margin-bottom: 1rem;
        transition: border-color 0.3s;
    }
    .api-panel.ok { border-color: var(--success); }
    .api-key-input {
        width: 100%; padding: 0.85rem 1rem;
        border-radius: 10px; border: 1px solid var(--border);
        background: var(--bg); color: var(--ink);
        font-family: ui-monospace, 'SF Mono', Menlo, monospace;
        font-size: 0.85rem; margin-bottom: 0.6rem;
    }
    .api-key-input:focus { outline: none; border-color: var(--emerald); }
    .api-save-btn {
        width: 100%; padding: 0.8rem 1.2rem;
        border-radius: 10px; border: none;
        background: linear-gradient(135deg, var(--emerald-dark), var(--emerald));
        color: #0f1a12;
        font-size: 0.9rem; font-weight: 700; font-family: inherit;
        cursor: pointer; transition: transform 0.1s, filter 0.2s;
        margin-bottom: 0.6rem;
    }
    .api-save-btn:active { transform: scale(0.98); }
    .api-save-btn:hover { filter: brightness(1.1); }
    .api-status-line {
        font-size: 0.75rem; padding: 0.55rem 0.85rem;
        border-radius: 8px; margin-bottom: 0.5rem;
        display: flex; align-items: center; gap: 0.5rem;
        background: var(--panel-2); color: var(--ink-dim);
        transition: all 0.3s;
    }
    .api-status-line.ok { background: rgba(46,204,113,0.15); color: var(--success); font-weight: 600; }
    .api-status-line .status-dot {
        width: 8px; height: 8px; border-radius: 50%;
        background: var(--ink-faint); flex-shrink: 0;
        transition: background 0.3s;
    }
    .api-status-line.ok .status-dot { background: var(--success); box-shadow: 0 0 8px var(--success); }
    .api-hint { font-size: 0.72rem; color: var(--ink-dim); margin-top: 0.4rem; }
    .api-hint a { color: var(--gold); text-decoration: underline; }
    .stat-line {
        font-size: 0.72rem; color: var(--ink-dim); margin-top: 0.5rem;
        padding: 0.5rem 0.7rem; background: var(--panel-2); border-radius: 8px;
        display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.3rem;
    }
    .wake-status {
        font-size: 0.72rem; padding: 0.5rem 0.7rem;
        border-radius: 8px; margin-top: 0.4rem;
        display: flex; justify-content: space-between; align-items: center;
        background: rgba(74,158,255,0.12); color: var(--info);
        flex-wrap: wrap; gap: 0.4rem;
    }
    .wake-status.active { background: rgba(46,204,113,0.15); color: var(--success); }
    .wake-status.warn { background: rgba(243,156,18,0.15); color: var(--warn); }
    .wake-status button {
        background: transparent; border: 1px solid currentColor;
        color: inherit; padding: 0.25rem 0.6rem; border-radius: 6px;
        font-size: 0.68rem; cursor: pointer; font-family: inherit;
    }

    .upload-zone {
        border: 2px dashed var(--border);
        border-radius: var(--radius);
        padding: 2rem 1rem;
        text-align: center;
        cursor: pointer;
        transition: all 0.25s;
        margin-bottom: 1rem;
        background: var(--panel);
        position: relative;
        overflow: hidden;
    }
    .upload-zone::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at center, rgba(46,204,113,0.1), transparent 70%);
        opacity: 0;
        transition: opacity 0.3s;
    }
    .upload-zone:hover::before { opacity: 1; }
    .upload-zone:active { border-color: var(--emerald); background: var(--panel-2); }
    .upload-zone.loading { pointer-events: none; opacity: 0.6; }
    .upload-zone input[type="file"] { display: none; }
    .upload-icon { font-size: 2.4rem; margin-bottom: 0.6rem; opacity: 0.8; }
    .upload-text { font-size: 0.95rem; color: var(--ink); margin-bottom: 0.2rem; font-weight: 600; }
    .upload-hint { font-size: 0.75rem; color: var(--ink-dim); }

    .images-grid {
        display: grid; grid-template-columns: repeat(auto-fill, minmax(90px, 1fr));
        gap: 0.5rem; margin-bottom: 1rem;
    }
    .image-card {
        position: relative; border-radius: 10px; overflow: hidden;
        border: 1px solid var(--border); background: var(--panel-2);
        aspect-ratio: 9/16;
        transition: transform 0.2s, border-color 0.2s;
    }
    .image-card:hover { transform: scale(1.03); border-color: var(--gold); }
    .image-card img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .image-card .remove-btn {
        position: absolute; top: 4px; right: 4px;
        background: rgba(231,76,60,0.85); color: #fff; border: none;
        width: 22px; height: 22px; border-radius: 50%; font-size: 11px;
        cursor: pointer; display: flex; align-items: center; justify-content: center;
        line-height: 1;
    }

    textarea {
        width: 100%; padding: 0.75rem 0.9rem; border-radius: 10px;
        border: 1px solid var(--border); background: var(--bg);
        color: var(--ink); font-family: inherit; font-size: 0.88rem;
        min-height: 80px; resize: vertical;
    }
    textarea:focus { outline: none; border-color: var(--emerald); }

    .prompt-main {
        width: 100%; padding: 0.9rem 1rem;
        border-radius: 10px; border: 1px solid var(--border);
        background: var(--bg); color: var(--ink);
        font-family: inherit; font-size: 0.9rem;
        min-height: 120px; resize: vertical; line-height: 1.55;
    }
    .prompt-main:focus { outline: none; border-color: var(--emerald); box-shadow: 0 0 0 3px rgba(46,204,113,0.15); }
    .prompt-main-hint {
        font-size: 0.72rem; color: var(--ink-dim);
        margin-top: 0.5rem; line-height: 1.45;
    }
    .prompt-main-hint strong { color: var(--gold); }

    .prompt-presets {
        display: flex; flex-wrap: wrap; gap: 0.4rem;
        margin-top: 0.7rem;
    }
    .prompt-preset {
        padding: 0.4rem 0.8rem; border-radius: 20px;
        border: 1px solid var(--border); background: var(--panel-2);
        font-size: 0.72rem; cursor: pointer;
        transition: all 0.15s; user-select: none;
        color: var(--ink-dim);
    }
    .prompt-preset:hover {
        border-color: var(--gold); color: var(--gold);
        background: rgba(241,196,15,0.08);
    }
    .prompt-preset:active { transform: scale(0.96); }

    .styles-grid {
        display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 0.5rem;
    }
    .style-card {
        padding: 0.8rem 0.9rem; border-radius: 10px;
        border: 1px solid var(--border); background: var(--panel-2);
        cursor: pointer; transition: all 0.2s;
        display: flex; align-items: center; gap: 0.5rem;
    }
    .style-card:hover { border-color: var(--gold); transform: translateY(-2px); }
    .style-card:active { transform: scale(0.98); }
    .style-card.selected {
        background: linear-gradient(135deg, var(--emerald-dark), var(--bordeaux));
        color: #fff; border-color: var(--gold);
        box-shadow: 0 0 15px rgba(46,204,113,0.3);
    }
    .style-card .style-emoji { font-size: 1.2rem; flex-shrink: 0; }
    .style-card .style-name { font-size: 0.8rem; font-weight: 600; line-height: 1.2; }
    .style-card .style-desc { font-size: 0.65rem; opacity: 0.7; margin-top: 0.1rem; line-height: 1.2; }

    .style-category-header {
        grid-column: 1 / -1;
        font-size: 0.7rem; font-weight: 700;
        color: var(--gold); text-transform: uppercase;
        letter-spacing: 0.08em;
        padding: 0.7rem 0 0.4rem;
        border-bottom: 1px solid var(--border);
        margin-bottom: 0.4rem;
    }
    .style-category-header:first-child { padding-top: 0; }
    .style-category-desc {
        grid-column: 1 / -1;
        font-size: 0.68rem; color: var(--ink-dim);
        font-style: italic; margin-bottom: 0.4rem; line-height: 1.35;
    }

    .no-style-card {
        grid-column: 1 / -1;
        padding: 0.85rem 1rem;
        border-radius: 10px;
        border: 2px dashed var(--border);
        background: transparent;
        text-align: center; cursor: pointer;
        transition: all 0.2s;
        font-size: 0.82rem; color: var(--ink-dim);
    }
    .no-style-card:active { transform: scale(0.99); }
    .no-style-card.selected {
        border-color: var(--emerald); border-style: solid;
        background: rgba(46,204,113,0.1); color: var(--emerald); font-weight: 700;
    }

    .control-row { margin-bottom: 0.9rem; }
    .control-row:last-child { margin-bottom: 0; }
    .control-label {
        display: block; font-size: 0.72rem; color: var(--gold);
        margin-bottom: 0.4rem; text-transform: uppercase; letter-spacing: 0.06em;
        font-weight: 700;
    }
    select {
        width: 100%; padding: 0.75rem 0.9rem; border-radius: 10px;
        border: 1px solid var(--border); background: var(--bg);
        color: var(--ink); font-family: inherit; font-size: 0.88rem;
        -webkit-appearance: none; appearance: none;
        background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='6' viewBox='0 0 10 6'><path fill='%23f1c40f' d='M0 0l5 6 5-6z'/></svg>");
        background-repeat: no-repeat;
        background-position: right 0.9rem center;
        background-size: 10px;
    }
    select:focus { outline: none; border-color: var(--emerald); }

    .btn-primary {
        width: 100%; padding: 1.15rem; border-radius: var(--radius);
        border: none;
        background: linear-gradient(135deg, var(--emerald-dark), var(--emerald), var(--gold));
        background-size: 200% 200%;
        color: #0f1a12;
        font-size: 1rem; font-weight: 800; font-family: inherit;
        cursor: pointer;
        transition: transform 0.1s, box-shadow 0.3s, background-position 0.5s;
        margin-bottom: 1rem;
        letter-spacing: 0.02em;
        box-shadow: 0 4px 20px rgba(46,204,113,0.3);
    }
    .btn-primary:hover:not(:disabled) {
        background-position: 100% 50%;
        box-shadow: 0 6px 25px rgba(241,196,15,0.4);
    }
    .btn-primary:active:not(:disabled) { transform: scale(0.98); }
    .btn-primary:disabled { opacity: 0.35; cursor: not-allowed; box-shadow: none; }

    .btn-stop {
        width: 100%; padding: 0.85rem; border-radius: var(--radius);
        border: 2px solid var(--error); background: transparent;
        color: var(--error); font-size: 0.9rem; font-weight: 700;
        font-family: inherit; cursor: pointer; margin-bottom: 1rem;
        display: none;
    }
    .btn-stop.visible { display: block; }

    .queue { margin-top: 1rem; }
    .queue-summary {
        background: var(--panel); border: 1px solid var(--border);
        border-radius: 10px; padding: 0.8rem 1rem; margin-bottom: 0.6rem;
        font-size: 0.78rem; display: flex; justify-content: space-between;
        align-items: center; flex-wrap: wrap; gap: 0.4rem;
    }
    .queue-summary .progress-text { color: var(--gold); font-weight: 700; }
    .queue-summary .eta-text { color: var(--ink-dim); }

    .queue-item {
        display: flex; align-items: center; gap: 0.8rem;
        padding: 0.75rem 0.9rem; border-radius: 10px;
        border: 1px solid var(--border); margin-bottom: 0.4rem;
        background: var(--panel); transition: all 0.3s;
        font-size: 0.82rem;
    }
    .queue-item.pending { opacity: 0.5; }
    .queue-item.creating { border-color: var(--warn); background: rgba(243,156,18,0.05); }
    .queue-item.processing { border-color: var(--emerald); background: rgba(46,204,113,0.05); }
    .queue-item.done { border-color: var(--success); background: rgba(46,204,113,0.08); }
    .queue-item.failed { border-color: var(--error); background: rgba(231,76,60,0.05); }
    .queue-item .q-icon { font-size: 1rem; width: 1.5rem; text-align: center; flex-shrink: 0; }
    .queue-item .q-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 600; }
    .queue-item .q-status { font-size: 0.72rem; color: var(--ink-dim); text-align: right; flex-shrink: 0; max-width: 60%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    .queue-more {
        text-align: center; padding: 0.5rem; color: var(--ink-dim);
        font-size: 0.75rem; font-style: italic;
    }

    .gallery { margin-top: 1.5rem; }
    .gallery-grid {
        display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
        gap: 0.8rem;
    }
    .gallery-item {
        border-radius: var(--radius); overflow: hidden;
        border: 1px solid var(--border); background: #000;
        animation: fadeIn 0.5s ease;
        transition: transform 0.2s, border-color 0.2s;
    }
    .gallery-item:hover { transform: translateY(-3px); border-color: var(--gold); }
    .gallery-item video { width: 100%; display: block; aspect-ratio: 9/16; object-fit: cover; }
    .gallery-item .g-caption {
        padding: 0.5rem 0.7rem; background: var(--panel);
        font-size: 0.7rem; color: var(--gold); font-weight: 600;
    }

    .status-bar {
        position: fixed; bottom: 0; left: 0; right: 0;
        background: linear-gradient(90deg, var(--emerald-dark), var(--bordeaux));
        color: #fff; padding: 0.8rem 1rem;
        font-size: 0.78rem; display: flex; align-items: center; gap: 0.6rem;
        transform: translateY(100%); transition: transform 0.3s;
        z-index: 100;
        box-shadow: 0 -4px 20px rgba(0,0,0,0.4);
        padding-bottom: max(0.8rem, env(safe-area-inset-bottom));
    }
